```json
{"tests": "import pytest\n\nimport main\n\n\ndef test_route_returns_ap_for_valid_invoice():\n    assert main.route({\"id\": \"I1\", \"vendor_id\": \"V9\"}) == \"AP\"\n\n\ndef test_route_rejects_missing_vendor_id():\n    with pytest.raises(ValueError):\n        main.route({\"id\": \"I2\"})\n", "covers": ["happy path", "missing vendor_id (DATA_ERROR)"]}
```

