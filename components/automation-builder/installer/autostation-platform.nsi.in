; =====================================================================================================
; AUTOSTATION platform installer  -  TEMPLATE
;
; Rendered by scripts/build_platform_installer.py. Installs the shared runtime (Python, wrapper-core,
; execution-framework) and platform secrets ONCE per machine. Individual automations are then deployed
; as thin "dropper" installers (~10 MB) that reference these shared components.
;
; Secrets (logging SSH key, registry read token) are NEVER substituted into this text: they are staged
; as separate files embedded by `File`, so this script is safe to log/archive.
;
; Silent: /S    Ring: /RING=pilot    Skip tray: /NOTRAY
; =====================================================================================================
Unicode true
SetCompressor /SOLID lzma
RequestExecutionLevel user
ManifestDPIAware true
@@DEFINES@@

!define PLATFORM_VERSION "@@PLATFORM_VERSION@@"
!define PUBLISHER        "@@PUBLISHER@@"
!define DEFAULT_RING     "@@DEFAULT_RING@@"
!define REGISTRY_URL     "@@REGISTRY_URL@@"
!define LOG_REMOTE       "@@LOG_REMOTE@@"
!define GIT_ARG          "@@GIT_ARG@@"
!define REGISTRY_PUBKEYS "@@REGISTRY_PUBKEYS@@"
!define LLM_ENDPOINT     "@@LLM_ENDPOINT@@"
!define LLM_MODEL        "@@LLM_MODEL@@"
!define WRAPPER_VERSION  "@@WRAPPER_VERSION@@"
!define UNINST_KEY       "Software\Microsoft\Windows\CurrentVersion\Uninstall\AUTOMAGIX-Platform"

!ifdef HAVE_ICON
  !define MUI_ICON   "@@ICON@@"
  !define MUI_UNICON "@@ICON@@"
!endif

Name "AUTOSTATION Platform ${PLATFORM_VERSION}"
OutFile "@@OUTFILE@@"
InstallDir "$LOCALAPPDATA\AUTOMAGIX"
InstallDirRegKey HKCU "Software\AUTOMAGIX" "InstallDir"
BrandingText "${PUBLISHER}"
ShowInstDetails show
ShowUninstDetails show

VIProductVersion "@@VIVERSION@@"
VIAddVersionKey "ProductName"     "AUTOMAGIX Platform"
VIAddVersionKey "ProductVersion"  "${PLATFORM_VERSION}"
VIAddVersionKey "FileVersion"     "${PLATFORM_VERSION}"
VIAddVersionKey "CompanyName"     "${PUBLISHER}"
VIAddVersionKey "LegalCopyright"  "${PUBLISHER}"
VIAddVersionKey "FileDescription" "AUTOSTATION platform runtime"

!include "MUI2.nsh"
!include "LogicLib.nsh"
!include "FileFunc.nsh"
!include "WordFunc.nsh"
!include "TextFunc.nsh"
!insertmacro GetParameters
!insertmacro GetOptions
!insertmacro VersionCompare
!insertmacro TrimNewLines

Var Ring
Var NoTray
Var PythonExe

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

; ---- helpers --------------------------------------------------------------------------------------
!macro RunPS SCRIPT ARGS
  nsExec::ExecToLog `"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$PLUGINSDIR\scripts\${SCRIPT}" ${ARGS}`
  Pop $0
!macroend

!macro FailInstall MSG CODE
  DetailPrint "ERROR: ${MSG}"
  MessageBox MB_OK|MB_ICONSTOP "${MSG}" /SD IDOK
  SetErrorLevel ${CODE}
  Abort
!macroend

Function .onInit
  ${GetParameters} $R0
  StrCpy $Ring "${DEFAULT_RING}"
  ClearErrors
  ${GetOptions} $R0 "/RING=" $R1
  ${IfNot} ${Errors}
    StrCpy $Ring $R1
  ${EndIf}
  ClearErrors
  ${If} $Ring != "dev"
  ${AndIf} $Ring != "pilot"
  ${AndIf} $Ring != "broad"
    MessageBox MB_OK|MB_ICONSTOP "Invalid /RING=$Ring (expected dev, pilot or broad)." /SD IDOK
    SetErrorLevel 3
    Abort
  ${EndIf}
  StrCpy $NoTray "0"
  ${GetOptions} $R0 "/NOTRAY" $R1
  ${IfNot} ${Errors}
    StrCpy $NoTray "1"
  ${EndIf}
  ClearErrors
FunctionEnd

; ---- install --------------------------------------------------------------------------------------
Section "Install" SecInstall
  SectionIn RO
  SetOverwrite on

  InitPluginsDir
  SetOutPath "$PLUGINSDIR\scripts"
  File "@@STAGE_DIR@@\scripts\install-check.ps1"
  File "@@STAGE_DIR@@\scripts\protect-secret.ps1"
  File "@@STAGE_DIR@@\scripts\restrict-acl.ps1"
  File "@@STAGE_DIR@@\scripts\set-credential.ps1"
  File "@@STAGE_DIR@@\scripts\configure-python.ps1"
  File "@@STAGE_DIR@@\scripts\write-platform-config.ps1"
  File "@@STAGE_DIR@@\scripts\first-run-platform.ps1"

  ; 1. prerequisites
  DetailPrint "Checking prerequisites..."
  nsExec::ExecToStack `"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$PLUGINSDIR\scripts\install-check.ps1" -InstallDir "$INSTDIR" ${GIT_ARG}`
  Pop $0
  Pop $1
  DetailPrint "$1"
  ${If} $0 != 0
    !insertmacro FailInstall "Prerequisite check failed. $1" 2
  ${EndIf}

  CreateDirectory "$INSTDIR\config"
  CreateDirectory "$INSTDIR\secrets"

  ; 2. Python interpreter
!ifdef HAVE_PYTHON_EMBED
  ${IfNot} ${FileExists} "$INSTDIR\python\python.exe"
    DetailPrint "Installing embedded Python..."
    SetOutPath "$INSTDIR\python"
    File /r "@@STAGE_DIR@@\python\*.*"
  ${EndIf}
  StrCpy $PythonExe `"$INSTDIR\python\python.exe"`
  !insertmacro RunPS "configure-python.ps1" '-PythonDir "$INSTDIR\python"'
  ${If} $0 != 0
    !insertmacro FailInstall "Could not configure the embedded Python (exit code $0)." 4
  ${EndIf}
!else
  StrCpy $PythonExe "python.exe"
!endif

  ; 3. wrapper-core
  StrCpy $R2 "0.0.0"
  ${If} ${FileExists} "$INSTDIR\wrapper-core\VERSION"
    FileOpen $R3 "$INSTDIR\wrapper-core\VERSION" r
    FileRead $R3 $R2
    FileClose $R3
    ${TrimNewLines} "$R2" $R2
  ${EndIf}
  ${VersionCompare} "${WRAPPER_VERSION}" "$R2" $R4
  ${If} $R4 == 1
  ${OrIfNot} ${FileExists} "$INSTDIR\wrapper-core\wrapper_core\__init__.py"
    DetailPrint "Installing wrapper-core ${WRAPPER_VERSION}..."
    SetOutPath "$INSTDIR\wrapper-core"
    File /r "@@STAGE_DIR@@\wrapper-core\*.*"
  ${Else}
    DetailPrint "wrapper-core $R2 already installed - keeping it."
  ${EndIf}

!ifdef HAVE_FRAMEWORK
  ; 4. execution-framework (Node runtime + playwright-core)
  ${IfNot} ${FileExists} "$INSTDIR\execution-framework\VERSION"
    DetailPrint "Installing execution-framework..."
    SetOutPath "$INSTDIR\execution-framework"
    File /r "@@STAGE_DIR@@\execution-framework\*.*"
  ${Else}
    DetailPrint "execution-framework already installed - keeping it."
  ${EndIf}
!endif

!ifdef HAVE_GIT
  ; 5. MinGit (git + ssh) for log transport
  ${IfNot} ${FileExists} "$INSTDIR\git\cmd\git.exe"
    DetailPrint "Installing bundled git..."
    SetOutPath "$INSTDIR\git"
    File /r "@@STAGE_DIR@@\git\*.*"
  ${EndIf}
!endif

!ifdef HAVE_KNOWN_HOSTS
  SetOutPath "$INSTDIR\config"
  File "@@STAGE_DIR@@\config\known_hosts"
!endif

  ; 6. platform configuration
  !insertmacro RunPS "write-platform-config.ps1" '-Out "$INSTDIR\config\platform.json" -Ring "$Ring" -RegistryUrl "${REGISTRY_URL}" -LogRemote "${LOG_REMOTE}" -LlmEndpoint "${LLM_ENDPOINT}" -LlmModel "${LLM_MODEL}" -RegistryPubKeys "${REGISTRY_PUBKEYS}"'
  ${If} $0 != 0
    !insertmacro FailInstall "Could not write platform.json (exit code $0)." 5
  ${EndIf}

  ; 7. secrets: DPAPI-protect shared SSH key + store registry token
!ifdef HAVE_SSH_KEY
  DetailPrint "Protecting the logging key with DPAPI..."
  SetOutPath "$PLUGINSDIR\sec"
  File "@@STAGE_DIR@@\secrets\logging_key"
  !insertmacro RunPS "protect-secret.ps1" '-InFile "$PLUGINSDIR\sec\logging_key" -OutFile "$INSTDIR\secrets\logging_key.dpapi" -DeleteInput'
  ${If} $0 != 0
    !insertmacro FailInstall "Could not protect the logging key (exit code $0)." 6
  ${EndIf}
!endif
!ifdef HAVE_TOKEN
  DetailPrint "Storing the registry read token in Windows Credential Manager..."
  SetOutPath "$PLUGINSDIR\sec"
  File "@@STAGE_DIR@@\secrets\registry_token"
  !insertmacro RunPS "set-credential.ps1" '-Target "AUTOMAGIX/registry_token" -SecretFile "$PLUGINSDIR\sec\registry_token"'
  ${If} $0 != 0
    !insertmacro FailInstall "Could not store the registry token (exit code $0)." 7
  ${EndIf}
!endif
!ifdef HAVE_LOG_TOKEN
  DetailPrint "Protecting the logging token with DPAPI..."
  SetOutPath "$PLUGINSDIR\sec"
  File "@@STAGE_DIR@@\secrets\logging_token"
  !insertmacro RunPS "protect-secret.ps1" '-InFile "$PLUGINSDIR\sec\logging_token" -OutFile "$INSTDIR\secrets\logging_token.dpapi" -DeleteInput'
  ${If} $0 != 0
    !insertmacro FailInstall "Could not protect the logging token (exit code $0)." 9
  ${EndIf}
!endif
  !insertmacro RunPS "restrict-acl.ps1" '-Path "$INSTDIR\secrets"'

  ; 8. write platform-version.txt (dropper compatibility check reads this)
  FileOpen $R5 "$INSTDIR\platform-version.txt" w
  FileWrite $R5 "${PLATFORM_VERSION}"
  FileClose $R5

  ; 9. Add/Remove Programs entry (HKCU, no admin)
  WriteUninstaller "$INSTDIR\uninstall-platform.exe"
  WriteRegStr   HKCU "Software\AUTOMAGIX" "InstallDir"       "$INSTDIR"
  WriteRegStr   HKCU "Software\AUTOMAGIX" "PlatformVersion"  "${PLATFORM_VERSION}"
  WriteRegStr   HKCU "${UNINST_KEY}" "DisplayName"     "AUTOSTATION Platform ${PLATFORM_VERSION}"
  WriteRegStr   HKCU "${UNINST_KEY}" "DisplayVersion"  "${PLATFORM_VERSION}"
  WriteRegStr   HKCU "${UNINST_KEY}" "Publisher"       "${PUBLISHER}"
  WriteRegStr   HKCU "${UNINST_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr   HKCU "${UNINST_KEY}" "UninstallString" `"$INSTDIR\uninstall-platform.exe"`
  WriteRegStr   HKCU "${UNINST_KEY}" "QuietUninstallString" `"$INSTDIR\uninstall-platform.exe" /S`
!ifdef HAVE_ICON
  WriteRegStr   HKCU "${UNINST_KEY}" "DisplayIcon"     "$INSTDIR\uninstall-platform.exe"
!endif
  WriteRegDWORD HKCU "${UNINST_KEY}" "NoModify" 1
  WriteRegDWORD HKCU "${UNINST_KEY}" "NoRepair" 1

  ; 10. first-run: heartbeat Task Scheduler + startup tray shortcut
  ${If} $NoTray == "0"
    !insertmacro RunPS "first-run-platform.ps1" '-Python $PythonExe -AutomagixHome "$INSTDIR"'
    ; advisory: first-run failure does not abort; automation dropper installs still work
  ${EndIf}
  DetailPrint "AUTOSTATION platform ${PLATFORM_VERSION} installed."
SectionEnd

; ---- uninstall ------------------------------------------------------------------------------------
Section "Uninstall"
  ${If} ${FileExists} "$INSTDIR\python\python.exe"
    StrCpy $PythonExe `"$INSTDIR\python\python.exe"`
  ${Else}
    StrCpy $PythonExe "python.exe"
    System::Call 'Kernel32::SetEnvironmentVariable(t, t)i("PYTHONPATH", "$INSTDIR\wrapper-core").r9'
  ${EndIf}
  System::Call 'Kernel32::SetEnvironmentVariable(t, t)i("AUTOMAGIX_HOME", "$INSTDIR").r9'

  ; decommission platform via wrapper-core (removes maintained state, emits a decommissioned event)
  nsExec::ExecToLog `$PythonExe -m wrapper_core platform-uninstall`
  Pop $0

  ; remove heartbeat task
  nsExec::ExecToLog `"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "Unregister-ScheduledTask -TaskPath '\AUTOMAGIX\' -TaskName 'heartbeat' -Confirm:$false -ErrorAction SilentlyContinue"`
  Pop $0

  ; remove startup tray shortcut
  nsExec::ExecToLog `"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "Remove-Item -Force ([System.Environment]::GetFolderPath('Startup') + '\AUTOSTATION Tray.lnk') -ErrorAction SilentlyContinue"`
  Pop $0

  ; only remove shared files if no automation uninstallers remain
  FindFirst $0 $1 "$INSTDIR\uninstall-*.exe"
  FindClose $0
  ${If} $1 == "" ; none left (platform uninstaller itself is already being run)
    DetailPrint "Removing shared platform files..."
    RMDir /r "$INSTDIR\python"
    RMDir /r "$INSTDIR\wrapper-core"
    RMDir /r "$INSTDIR\execution-framework"
    RMDir /r "$INSTDIR\git"
    RMDir /r "$INSTDIR\automations"
    RMDir /r "$INSTDIR\bundled"
    RMDir /r "$INSTDIR\local-logs"
    RMDir /r "$INSTDIR\state"
    RMDir /r "$INSTDIR\bin"
    RMDir /r "$INSTDIR\runs"
    RMDir /r "$INSTDIR\logs"
    RMDir /r "$INSTDIR\config"
    RMDir /r "$INSTDIR\secrets"
    Delete "$INSTDIR\platform-version.txt"
    RMDir "$INSTDIR\spool"
    RMDir "$INSTDIR"
    DeleteRegKey HKCU "Software\AUTOMAGIX"
  ${EndIf}
  Delete "$INSTDIR\uninstall-platform.exe"
  DeleteRegKey HKCU "${UNINST_KEY}"
SectionEnd
