# AUTOSTATION is airgapped: packages come ONLY from the internal mirror. There is no public-registry fallback.
# Replace the placeholder below (or set via CI variable NPM_CONFIG_REGISTRY) with your internal npm mirror.
registry=https://npm-mirror.internal.example.com/repository/npm-proxy/
# Never fetch browsers: automations drive the Edge/Chrome already installed on the VDI (channel: 'msedge').
playwright_skip_browser_download=1
fund=false
audit=false
update-notifier=false
# Reproducible builds: always install from package-lock.json (see README "Dependency policy").
package-lock=true
save-exact=true
